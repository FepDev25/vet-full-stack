# .env.example — Plantilla de variables de entorno
# Sistema Veterinario
# Copiar a .env en la raiz del proyecto y completar los valores:
#   cp .env.example .env
#
# Spring Boot lo carga via:
#   spring.config.import: "optional:file:../.env[.properties]"
#
# Formato: KEY=VALUE (estilo Properties, sin `export`).

# ----- Base de datos --------------------------------------------------------
DB_HOST=localhost
DB_PORT=5435
DB_NAME=veterinaria
DB_USERNAME=vetuser
DB_PASSWORD=change_me_in_local

# ----- JWT (entorno dev) ----------------------------------------------------
# Generar uno nuevo con: openssl rand -base64 48
JWT_SECRET=change_me_in_local_generate_with_openssl_rand_base64_48
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ----- JWT (perfil test, valor separado del dev) ---------------------------
JWT_SECRET_TEST=change_me_in_local_generate_with_openssl_rand_base64_48

# ----- CORS -----------------------------------------------------------------
# Origenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- AI Providers ---------------------------------------------------------
ANTHROPIC_API_KEY=change_me_in_local
GEMINI_API_KEY=change_me_in_local

# OpenAI (reservado, sin uso actual)
OPENAI_API_KEY=
